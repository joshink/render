{
  "version": "1.0",
  "output": "test_cases/outputs/13_custom_shader_effect.png",
  "composition": {
    "width": 800,
    "height": 800,
    "fps": 30,
    "duration": 2.0
  },
  "assets": {
    "input_image": {
      "type": "image",
      "path": "input.jpg"
    },
    "custom_wave_shader": {
      "type": "shader",
      "path": "test_cases/custom_wave.wgsl"
    }
  },
  "tracks": [
    {
      "id": "background_track",
      "clips": [
        {
          "id": "background_clip",
          "type": "media",
          "asset": "input_image",
          "duration": 2.0
        }
      ]
    },
    {
      "id": "effect_track",
      "clips": [
        {
          "id": "wave_effect",
          "type": "effect",
          "shader": "custom_wave_shader",
          "duration": 2.0,
          "params": {
            "amplitude": 0.05,
            "frequency": 10.0
          }
        }
      ]
    }
  ]
}
