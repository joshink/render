{
  "version": "1.0",
  "output": "test_cases/outputs/17_depth_blur.png",
  "composition": {
    "width": 800,
    "height": 800,
    "fps": 30,
    "duration": 2.0
  },
  "assets": {
    "input_image": {
      "type": "image",
      "path": "input.jpg"
    }
  },
  "tracks": [
    {
      "id": "main_track",
      "clips": [
        {
          "id": "input_clip",
          "type": "media",
          "asset": "input_image",
          "duration": 2.0
        }
      ]
    },
    {
      "id": "effect_track",
      "clips": [
        {
          "id": "depth_blur_effect",
          "type": "effect",
          "duration": 2.0,
          "effects": [
            {
              "type": "depth_blur",
              "params": {
                "focus_x": 0.5,
                "focus_y": 0.5,
                "focus_radius": 0.25,
                "near_blur": 0.0,
                "far_blur": 10.0
              }
            }
          ]
        }
      ]
    }
  ]
}
