{
  "version": "1.0",
  "output": "test_cases/outputs/07_movie.mp4",
  "composition": {
    "width": 800,
    "height": 800,
    "fps": 30,
    "duration": 2.0
  },
  "assets": {
    "input_image": {
      "type": "image",
      "path": "input.jpg"
    }
  },
  "tracks": [
    {
      "id": "main_track",
      "clips": [
        {
          "id": "input_clip",
          "type": "media",
          "asset": "input_image",
          "duration": 2.0,
          "effects": [
            {
              "type": "grayscale",
              "params": {
                "enabled": [
                  { "time": 0.0, "value": 1.0 },
                  { "time": 1.0, "value": 1.0 },
                  { "time": 1.001, "value": 0.0 },
                  { "time": 2.0, "value": 0.0 }
                ]
              }
            },
            {
              "type": "brightness",
              "params": {
                "factor": {
                  "expression": "1.2 * (1.0 + 0.8 * sin(clip_time * 2.0 * pi))"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
