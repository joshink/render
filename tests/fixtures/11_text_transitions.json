              "children": [
                {
                  "type": "text",
                  "text": "ANIMATED TEXT",
                  "font": "inter",
                  "font_size": 72.0,
                  "color": [1.0, 0.9, 0.1, 1.0],
                  "alignment": "center",
                  "axes": {
                    "wght": 800.0
                  }
                },
                {
                  "type": "text",
                  "text": "Transitions are beautiful.",
                  "font": "inter_italic",
                  "font_size": 48.0,
